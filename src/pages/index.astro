---
import Base from "../layouts/Base.astro";
import ChapterNav from "../components/ChapterNav.astro";
import Hero from "../components/Hero.astro";
import Ch05ScaledDotProduct from "../components/viz/Ch05ScaledDotProduct.tsx";
---

<Base
  title="Attention Is All You Need — an interactive explainer"
  description="The 2017 Transformer paper, worked through on one six-word sentence with numbers small enough to check by hand."
>
  <ChapterNav />

  <main>
    <Hero />

    <!--
      `client:visible` rather than `client:load`: the island's markup is
      server-rendered either way, so the first beat of every chapter is in the
      HTML and readable before any JavaScript arrives.
    -->
    <Ch05ScaledDotProduct client:visible />
  </main>

  <footer class="footer">
    <p>
      Worked from <a href="https://arxiv.org/abs/1706.03762">Vaswani et al.,
      “Attention Is All You Need” (arXiv:1706.03762)</a>. Every number on this
      page is computed from the weights it shows; none of them come from a
      trained model.
    </p>
  </footer>
</Base>
