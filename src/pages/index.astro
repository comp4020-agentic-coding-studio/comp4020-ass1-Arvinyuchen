---
import TransformerDiagram from "../components/TransformerDiagram.astro";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Transformer, one stage at a time</title>
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
        <a href="#diagram">Jump to interactive diagram</a>
      </nav>
      <h1>The Transformer, one stage at a time</h1>
      <p>
        An interactive walk through the encoder half of the Transformer architecture from
        <a href="https://arxiv.org/pdf/1706.03762" target="_blank" rel="noopener">
          "Attention Is All You Need"</a
        >, over a small fixed toy sentence. It's redrawn in an original style rather than
        traced from the paper's Figure 1 or from
        <a href="https://jalammar.github.io/illustrated-transformer/" target="_blank" rel="noopener"
          >The Illustrated Transformer</a
        >; every number shown is computed live from a small set of fixed toy weights, not
        a trained model's output.
      </p>
    </header>
    <main id="diagram">
      <h2>The encoder stack</h2>
      <TransformerDiagram />
    </main>
    <style>
      body {
        margin: 0;
        padding: 2rem;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
        color: #1a1a1a;
      }

      header,
      main {
        max-width: 46rem;
        margin: 0 auto;
      }

      a {
        color: #0b5fff;
      }
    </style>
  </body>
</html>
