---
import { STAGES } from "../lib/stages";

const initialStage = STAGES[0]!;
---

<div class="stepper">
  <div class="tablist" role="tablist" aria-label="Transformer stages" data-testid="interaction-trigger">
    {
      STAGES.map((stage, index) => (
        <button
          type="button"
          role="tab"
          class="tab"
          data-stage={stage.id}
          aria-selected={stage.id === initialStage.id ? "true" : "false"}
          aria-controls={`panel-${stage.id}`}
          id={`tab-${stage.id}`}
        >
          <span class="tab-index">{index + 1}</span>
          {stage.title}
        </button>
      ))
    }
  </div>
  <p class="status" aria-live="polite">
    Step 1 of {STAGES.length}: {initialStage.title}
  </p>
</div>

<style>
  .stepper {
    display: grid;
    gap: var(--space-3);
  }

  /* One segmented control rather than four floating pills. */
  .tablist {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    overflow: hidden;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* Equal quarters: a long label wraps inside its own tab rather than
       pushing the whole segmented control onto a second row. */
    flex: 1 1 0;
    justify-content: center;
    padding: var(--space-3);
    min-height: 44px;
    border: 0;
    border-left: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: 1.3;
    text-align: center;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .tab:first-child {
    border-left: 0;
  }

  /* The track clips overflow, so the focus ring has to sit inside the tab. */
  .tab:focus-visible {
    outline-offset: -3px;
    border-radius: 0;
  }

  .tab:hover {
    background: var(--accent-tint);
    color: var(--accent-strong);
  }

  .tab[aria-selected="true"] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .tab-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
    transition: color var(--dur-fast) var(--ease);
  }

  .tab:hover .tab-index {
    color: var(--accent);
  }

  .tab[aria-selected="true"] .tab-index {
    color: rgb(255 255 255 / 70%);
  }

  /* Four across doesn't fit a phone; two rows of two beats three-plus-one. */
  @media (max-width: 560px) {
    .tab {
      flex: 1 1 40%;
    }

    .tab:nth-child(3) {
      border-left: 0;
    }
  }

  .status {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
</style>
