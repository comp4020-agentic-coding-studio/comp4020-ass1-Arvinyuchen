---
import { STAGES } from "../lib/stages";

const initialStageId = STAGES[0]!.id;
---

<svg
  class="diagram"
  viewBox="0 0 640 560"
  role="img"
  aria-labelledby="diagram-title diagram-desc"
>
  <title id="diagram-title">Transformer encoder, redrawn</title>
  <desc id="diagram-desc">
    A stack of boxes from bottom to top: embedding, positional encoding, multi-head
    attention, and feed forward, the last two repeated N times. A dimmed mirrored
    column to the right represents the decoder, which this page does not make
    interactive.
  </desc>

  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" />
    </marker>
  </defs>

  <!-- encoder column: the four interactive stages -->
  <g data-diagram-block={STAGES[0]!.id} data-active={STAGES[0]!.id === initialStageId ? "true" : "false"}>
    <rect class="block" x="30" y="470" width="110" height="50" rx="6" />
    <text class="block-label" x="85" y="495">{STAGES[0]!.diagramLabel}</text>
  </g>

  <g data-diagram-block={STAGES[1]!.id} data-active={STAGES[1]!.id === initialStageId ? "true" : "false"}>
    <rect class="block" x="160" y="470" width="120" height="50" rx="6" />
    <text class="block-label" x="220" y="495">{STAGES[1]!.diagramLabel}</text>
  </g>

  <circle class="merge" cx="150" cy="430" r="14" aria-hidden="true" />
  <text class="merge-label" x="150" y="435" aria-hidden="true">+</text>

  <path class="flow" d="M150,416 L150,406" marker-end="url(#arrow)" aria-hidden="true" />

  <g data-diagram-block={STAGES[2]!.id} data-active={STAGES[2]!.id === initialStageId ? "true" : "false"}>
    <rect class="block" x="30" y="336" width="250" height="50" rx="6" />
    <text class="block-label" x="155" y="361">{STAGES[2]!.diagramLabel}</text>
  </g>

  <rect class="add-norm" x="30" y="298" width="250" height="24" rx="4" aria-hidden="true" />
  <text class="add-norm-label" x="155" y="314" aria-hidden="true">Add &amp; Norm</text>

  <path class="flow" d="M155,298 L155,286" marker-end="url(#arrow)" aria-hidden="true" />

  <g data-diagram-block={STAGES[3]!.id} data-active={STAGES[3]!.id === initialStageId ? "true" : "false"}>
    <rect class="block" x="30" y="212" width="250" height="50" rx="6" />
    <text class="block-label" x="155" y="237">{STAGES[3]!.diagramLabel}</text>
  </g>

  <rect class="add-norm" x="30" y="174" width="250" height="24" rx="4" aria-hidden="true" />
  <text class="add-norm-label" x="155" y="190" aria-hidden="true">Add &amp; Norm</text>

  <path class="flow" d="M155,174 L155,148" marker-end="url(#arrow)" aria-hidden="true" />
  <text class="flow-label" x="155" y="130" aria-hidden="true">Encoder output</text>

  <path class="flow" d="M85,470 L85,406 L145,406" aria-hidden="true" />

  <!-- ×N bracket around the repeated attention + feed-forward sub-stack -->
  <path
    class="bracket"
    d="M300,336 L312,336 L312,198 L300,198"
    fill="none"
    aria-hidden="true"
  />
  <text class="bracket-label" x="320" y="270" aria-hidden="true">×N</text>

  <!-- decoder: dimmed, non-interactive mirror, kept only for Fig-1 visual fidelity -->
  <g class="decoder" aria-hidden="true">
    <rect class="block block--dim" x="400" y="470" width="110" height="50" rx="6" />
    <text class="block-label block-label--dim" x="455" y="495">Embedding</text>

    <rect class="block block--dim" x="530" y="470" width="110" height="50" rx="6" />
    <text class="block-label block-label--dim" x="585" y="495">Positional encoding</text>

    <rect class="block block--dim" x="400" y="380" width="240" height="42" rx="6" />
    <text class="block-label block-label--dim" x="520" y="404">Masked Multi-Head Attention</text>

    <rect class="add-norm add-norm--dim" x="400" y="348" width="240" height="20" rx="4" />

    <rect class="block block--dim" x="400" y="270" width="240" height="42" rx="6" />
    <text class="block-label block-label--dim" x="520" y="294">Multi-Head Attention</text>

    <rect class="add-norm add-norm--dim" x="400" y="238" width="240" height="20" rx="4" />

    <rect class="block block--dim" x="400" y="160" width="240" height="42" rx="6" />
    <text class="block-label block-label--dim" x="520" y="184">Feed Forward</text>

    <rect class="add-norm add-norm--dim" x="400" y="128" width="240" height="20" rx="4" />

    <rect class="block block--dim" x="400" y="70" width="240" height="42" rx="6" />
    <text class="block-label block-label--dim" x="520" y="94">Linear &amp; Softmax</text>
  </g>
</svg>

<p class="decoder-caption">
  The decoder (dimmed, right) mirrors this shape — masked self-attention, attention
  over the encoder's output, then feed-forward — but isn't interactive here. This
  page's one idea is the encoder stack on the left.
</p>

<style>
  .diagram {
    width: 100%;
    height: auto;
    max-width: 46rem;
  }

  .block {
    fill: #eef2ff;
    stroke: #3730a3;
    stroke-width: 1.5;
    transition: fill 0.2s, stroke-width 0.2s;
  }

  .block-label {
    fill: #1e1b4b;
    font-size: 15px;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  [data-diagram-block][data-active="true"] .block {
    fill: #4338ca;
    stroke-width: 2.5;
  }

  [data-diagram-block][data-active="true"] .block-label {
    fill: #ffffff;
    font-weight: 600;
  }

  .add-norm {
    fill: #f4f4f5;
    stroke: #a1a1aa;
    stroke-width: 1;
  }

  .add-norm-label {
    fill: #52525b;
    font-size: 11px;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .merge {
    fill: #ffffff;
    stroke: #3730a3;
    stroke-width: 1.5;
  }

  .merge-label {
    fill: #3730a3;
    font-size: 16px;
    text-anchor: middle;
  }

  .flow {
    stroke: #52525b;
    stroke-width: 1.5;
    fill: none;
  }

  .flow-label {
    fill: #3f3f46;
    font-size: 13px;
    text-anchor: middle;
  }

  .bracket {
    stroke: #71717a;
    stroke-width: 1.5;
  }

  .bracket-label {
    fill: #3f3f46;
    font-size: 14px;
  }

  .block--dim {
    fill: #f4f4f5;
    stroke: #a1a1aa;
    opacity: 0.55;
  }

  .block-label--dim {
    fill: #71717a;
    font-size: 13px;
    text-anchor: middle;
    dominant-baseline: middle;
    opacity: 0.85;
  }

  .add-norm--dim {
    fill: #fafafa;
    stroke: #d4d4d8;
    opacity: 0.55;
  }

  .decoder-caption {
    max-width: 46rem;
    font-size: 0.9rem;
    color: #52525b;
  }
</style>
