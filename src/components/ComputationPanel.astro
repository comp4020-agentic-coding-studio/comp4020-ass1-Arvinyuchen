---
import { STAGES } from "../lib/stages";
import {
  TOKENS,
  MODEL_DIM,
  HEAD_COUNT,
  embed,
  positionalEncoding,
  selfAttention,
  feedForward,
} from "../lib/toy-example";

const initialStageId = STAGES[0]!.id;
const defaultToken = 0;
const defaultHead = 0;

const embeddings = TOKENS.map((token) => ({ token, vector: embed(token) }));

const defaultPosition = 0;
const positionalVector = positionalEncoding(defaultPosition);

const attention = selfAttention(defaultToken, defaultHead);

const feedForwardInput = embed(TOKENS[defaultToken]!);
const feedForwardOutput = feedForward(feedForwardInput);

const dimensions = Array.from({ length: MODEL_DIM }, (_, index) => index);

function fmt(n: number): string {
  return n.toFixed(2);
}

function weightAlpha(weight: number): number {
  return Math.round(weight * 100) / 100;
}
---

<div class="panels">
  <div
    data-stage-panel
    data-stage="embedding"
    id="panel-embedding"
    role="tabpanel"
    aria-labelledby="tab-embedding"
    aria-hidden={initialStageId === "embedding" ? "false" : "true"}
    hidden={initialStageId === "embedding" ? undefined : true}
  >
    <h3>Input embedding</h3>
    <p>Each toy token is looked up in a fixed table and becomes a 4-number vector.</p>
    <table>
      <caption class="sr-only">Toy embedding vectors</caption>
      <thead>
        <tr>
          <th scope="col">Token</th>
          {dimensions.map((d) => <th scope="col" class="col-num">d{d}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          embeddings.map(({ token, vector }) => (
            <tr>
              <th scope="row">{token}</th>
              {vector.map((value) => (
                <td class="num">{fmt(value)}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div
    data-stage-panel
    data-stage="positional-encoding"
    id="panel-positional-encoding"
    role="tabpanel"
    aria-labelledby="tab-positional-encoding"
    aria-hidden={initialStageId === "positional-encoding" ? "false" : "true"}
    hidden={initialStageId === "positional-encoding" ? undefined : true}
  >
    <h3>Positional encoding</h3>
    <p>
      A fixed sine/cosine vector, one per position, added to the embedding so word order
      isn't lost. Drag the slider to see the vector at each position in the toy sentence.
    </p>
    <label class="control-label control-label--inline" for="position-slider">
      <span>Position</span>
      <span class="num" data-position-value>{defaultPosition}</span>
      <span class="control-label__token" data-position-token>{TOKENS[defaultPosition]}</span>
    </label>
    <input
      type="range"
      id="position-slider"
      min="0"
      max={TOKENS.length - 1}
      step="1"
      value={defaultPosition}
    />
    <p class="readout">
      <span class="readout__label">Encoding vector</span>
      <span class="num" data-position-vector>[{positionalVector.map(fmt).join(", ")}]</span>
    </p>
  </div>

  <div
    data-stage-panel
    data-stage="self-attention"
    id="panel-self-attention"
    role="tabpanel"
    aria-labelledby="tab-self-attention"
    aria-hidden={initialStageId === "self-attention" ? "false" : "true"}
    hidden={initialStageId === "self-attention" ? undefined : true}
  >
    <h3>Self-attention</h3>
    <p>
      Pick a query token and one of 8 toy attention heads. The weights below are a real
      softmax over that head's scaled dot products &mdash; not invented numbers.
    </p>

    <div class="control-label" id="token-picker-label">Query token</div>
    <div class="picker" role="group" aria-labelledby="token-picker-label">
      {
        TOKENS.map((token, index) => (
          <button
            type="button"
            data-token={token}
            aria-pressed={index === defaultToken ? "true" : "false"}
          >
            {token}
          </button>
        ))
      }
    </div>

    <div class="control-label" id="head-picker-label">Attention head</div>
    <div class="picker picker--dense" role="group" aria-labelledby="head-picker-label">
      {
        Array.from({ length: HEAD_COUNT }, (_, head) => (
          <button
            type="button"
            class="num"
            data-head={head}
            aria-pressed={head === defaultHead ? "true" : "false"}
          >
            {head + 1}
          </button>
        ))
      }
    </div>

    <table data-attention-table>
      <caption class="sr-only">Attention weights from the query token to every token</caption>
      <thead>
        <tr>
          <th scope="col">Token</th>
          <th scope="col" class="col-num">Weight</th>
        </tr>
      </thead>
      <tbody>
        {
          TOKENS.map((token, index) => (
            <tr>
              <th scope="row">{token}</th>
              <td
                class="num"
                data-weight-cell={index}
                style={`--weight: ${weightAlpha(attention.weights[index]!)}`}
              >
                {fmt(attention.weights[index]!)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div
    data-stage-panel
    data-stage="feed-forward"
    id="panel-feed-forward"
    role="tabpanel"
    aria-labelledby="tab-feed-forward"
    aria-hidden={initialStageId === "feed-forward" ? "false" : "true"}
    hidden={initialStageId === "feed-forward" ? undefined : true}
  >
    <h3>Feed-forward</h3>
    <p>
      The same small two-layer network (linear, ReLU, linear) is applied to every position on
      its own. Shown here on <strong>{TOKENS[defaultToken]}</strong>'s embedding, not chained
      after attention &mdash; the point is the mechanism, not the full data path.
    </p>
    <table>
      <caption class="sr-only">Feed-forward input and output vectors</caption>
      <thead>
        <tr>
          <th scope="col">Vector</th>
          {dimensions.map((d) => <th scope="col" class="col-num">d{d}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Input</th>
          {feedForwardInput.map((value) => <td class="num">{fmt(value)}</td>)}
        </tr>
        <tr>
          <th scope="row">Output</th>
          {feedForwardOutput.map((value) => <td class="num">{fmt(value)}</td>)}
        </tr>
      </tbody>
    </table>
  </div>
</div>

<style>
  .panels {
    /* Holds the card's height steady as panels of different lengths swap in. */
    min-height: 20rem;
  }

  [data-stage-panel]:not([hidden]) {
    animation: panel-in var(--dur) var(--ease) both;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  h3 {
    margin-bottom: var(--space-2);
  }

  p {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-2);
  }

  table {
    margin: var(--space-4) 0 0;
    border-collapse: collapse;
    font-family: var(--font-ui);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
    text-align: left;
    font-size: var(--text-sm);
  }

  thead th {
    border-bottom: 1px solid var(--rule-strong);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  tbody th {
    font-weight: 600;
  }

  .col-num,
  td.num {
    text-align: right;
  }

  td[data-weight-cell] {
    background-color: rgb(var(--accent-rgb) / var(--weight, 0));
    transition: background-color var(--dur) var(--ease);
  }

  .control-label {
    display: block;
    margin-top: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Astro trims the whitespace between adjacent expressions, so the gap
     between "Position", the index, and the token has to be layout, not text. */
  .control-label--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .control-label__token {
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .readout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }

  .readout__label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  input[type="range"] {
    display: block;
    width: 100%;
    max-width: 20rem;
    min-height: 44px;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .picker button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .picker--dense button {
    padding: 0;
  }

  .picker button:hover {
    border-color: var(--accent);
    background: var(--accent-tint);
    color: var(--accent-strong);
  }

  .picker button[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
